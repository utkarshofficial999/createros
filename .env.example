# ==============================================================================
# CreatorOS Environment Configuration
# Agent Arena 2026 - Track 3: Self-Improving Content Studio
# Sponsor: Mesh API Gateway (https://api.meshapi.ai)
# ==============================================================================

# Database (defaults to local SQLite; PostgreSQL supported via asyncpg)
DATABASE_URL=sqlite+aiosqlite:///./creatoros.db

# Mesh API Gateway (Mandatory Sponsor Rule - All LLM & Embedding calls route here)
# Get your API key starting with 'rsk_' from https://meshapi.ai
MESH_API_KEY=rsk_your_mesh_api_key_here
MESH_BASE_URL=https://api.meshapi.ai/v1

# Role-based Model Routing via Mesh Gateway
MESH_MODEL_DEFAULT=openai/gpt-4o
MESH_MODEL_ANALYST=openai/gpt-4o
MESH_MODEL_STRATEGIST=openai/gpt-4o
MESH_MODEL_WRITER=openai/gpt-4o-mini
MESH_MODEL_CRITIC=openai/gpt-4o
MESH_MODEL_JUDGE=openai/gpt-4o
MESH_MODEL_REPURPOSER=openai/gpt-4o-mini
MESH_MODEL_FALLBACK=openai/gpt-4o-mini

# Text Embeddings via Mesh Gateway
MESH_EMBEDDING_MODEL=openai/text-embedding-3-small

# Vector Database (Optional cloud persistence for embeddings generated via Mesh)
# Note: An in-memory vector store with cosine similarity is included as standard.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=creatoros-posts
PINECONE_ENVIRONMENT=us-east-1

# Quality Gate & Revision Loop Configuration
QUALITY_GATE_THRESHOLD=7.5
MAX_REVISE_ITERATIONS=2

# Frontend Client Configuration
VITE_API_BASE_URL=http://localhost:8000
