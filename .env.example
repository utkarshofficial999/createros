# CreatorOS Environment Configuration

# Database (defaults to local sqlite)
DATABASE_URL=sqlite+aiosqlite:///./creatoros.db

# LLM Keys (optional - app automatically uses deterministic fallback if keys are omitted)
OPENAI_API_KEY=
GEMINI_API_KEY=

# LLM Provider selection: "auto", "gemini", "openai", or "demo"
LLM_PROVIDER=auto

# Frontend API URL
VITE_API_BASE_URL=http://localhost:8000
